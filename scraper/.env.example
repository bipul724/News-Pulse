# Same Supabase PostgreSQL database as the backend
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Comma-separated RSS feed URLs (at least 3)
RSS_FEEDS=http://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.npr.org/1004/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/World.xml

# Minimum average cosine similarity for article groups to merge (see README)
SIMILARITY_THRESHOLD=0.12

# Per-request timeout for article page downloads
ARTICLE_TIMEOUT_SECONDS=10

# Article pages downloaded in parallel (bounded thread pool)
EXTRACTION_CONCURRENCY=5

# Characters of each article body used for clustering (the lead paragraphs)
MAX_CLUSTER_TEXT_LENGTH=1000
