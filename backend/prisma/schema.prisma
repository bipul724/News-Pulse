generator client {
  provider             = "prisma-client"
  output               = "../src/generated/prisma"
  moduleFormat         = "esm"
  generatedFileExtension = "ts"
  importFileExtension  = "ts"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id          String    @id @default(uuid())
  source      String
  headline    String
  summary     String?
  body        String?
  url         String    @unique
  publishedAt DateTime
  createdAt   DateTime  @default(now())
  clusterId   String?
  cluster     Cluster?  @relation(fields: [clusterId], references: [id], onDelete: SetNull)
}

model Cluster {
  id        String    @id @default(uuid())
  label     String
  createdAt DateTime  @default(now())
  articles  Article[]
}

model IngestionJob {
  id              String    @id @default(uuid())
  status          String
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?
  // Parsed from the scraper's own log lines; null when a run never reported them.
  fetchedArticles Int?
  newArticles     Int?
  clustersCreated Int?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}
