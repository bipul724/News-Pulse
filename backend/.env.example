PORT=5000
# Comma-separate several allowed origins if needed
FRONTEND_URL=http://localhost:3000
PYTHON_COMMAND=python3
SCRAPER_PATH=../scraper
# Stop an ingestion run (and mark it failed) after this many minutes
INGEST_TIMEOUT_MINUTES=5
# For hosted deployments use Supabase's Session pooler URL (IPv4); see docs/deployment.md
DATABASE_URL="postgresql://user:password@host:port/postgres"
